          "name": "Admin",
          "item": [
            {
              "name": "Create Broadcast Unit",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"type\": \"FLIGHT_CASE\",\n  \"slug\": \"bc-001\",\n  \"title\": \"Broadcast Unit BC-001\",\n  \"summary\": \"Compact production broadcast unit with 4K switching capabilities.\",\n  \"description\": \"This broadcast unit features a complete production setup including vision mixer, audio console, replay system, and monitoring infrastructure. Designed for rapid deployment in remote locations.\",\n  \"specs\": {\n    \"dimensions\": {\n      \"length\": \"6m\",\n      \"width\": \"2.5m\",\n      \"height\": \"2.8m\"\n    },\n    \"power\": \"3-phase 400V\",\n    \"cameras\": 8,\n    \"audioChannels\": 32\n  },\n  \"coverImage\": \"https://example.com/images/broadcast-units/bc-001.jpg\",\n  \"gallery\": [\n    {\n      \"url\": \"https://example.com/images/broadcast-units/bc-001-interior.jpg\",\n      \"alt\": \"BC-001 Interior\"\n    }\n  ],\n  \"isPublished\": false,\n  \"order\": 1,\n  \"items\": [\n    {\n      \"group\": \"CAMERAS\",\n      \"title\": \"Sony PXW-FX9\",\n      \"qty\": 4,\n      \"notes\": \"4K Full Frame\",\n      \"order\": 1\n    },\n    {\n      \"group\": \"AUDIO\",\n      \"title\": \"Yamaha QL5\",\n      \"qty\": 1,\n      \"notes\": \"32-channel mixer\",\n      \"order\": 2\n    }\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/admin/broadcast-units",
                  "host": ["{{baseUrl}}"],
                  "path": ["admin", "broadcast-units"]
                },
                "description": "Create a new broadcast unit (Super Admin, Admin, Author). Type must be one of: OBVAN, FLIGHT_CASE, SNG, INTERNET_BROADCAST, OTHER. Items group must be one of the BroadcastUnitItemGroup enum values."
              },
              "response": []
            },
