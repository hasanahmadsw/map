                }
              ]
            },
            "description": "Get paginated list of featured published services (public endpoint)."
          },
          "response": []
        },
        {
          "name": "Get Service by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/services/slug/:slug",
              "host": ["{{baseUrl}}"],
              "path": ["services", "slug", ":slug"],
              "variable": [
                {
                  "key": "slug",
                  "value": "video-production",
                  "description": "Service slug"
                }
              ]
            },
            "description": "Get published service by slug (public endpoint)"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
