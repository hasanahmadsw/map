                  "mode": "raw",
                  "raw": "{\n  \"facilityId\": 1,\n  \"slug\": \"fc-001\",\n  \"title\": \"Flight Case FC-001\",\n  \"summary\": \"Compact production flight case with 4K switching capabilities.\",\n  \"description\": \"This flight case features a complete production setup including vision mixer, audio console, replay system, and monitoring infrastructure. Designed for rapid deployment in remote locations.\",\n  \"specs\": {\n    \"dimensions\": {\n      \"length\": \"6m\",\n      \"width\": \"2.5m\",\n      \"height\": \"2.8m\"\n    },\n    \"power\": \"3-phase 400V\",\n    \"cameras\": 8,\n    \"audioChannels\": 32\n  },\n  \"coverImage\": \"https://example.com/images/facility-units/fc-001.jpg\",\n  \"gallery\": [\n    {\n      \"url\": \"https://example.com/images/facility-units/fc-001-interior.jpg\",\n      \"alt\": \"FC-001 Interior\"\n    }\n  ],\n  \"isPublished\": false,\n  \"order\": 1,\n  \"items\": [\n    {\n      \"group\": \"CAMERAS\",\n      \"title\": \"Sony PXW-FX9\",\n      \"qty\": 4,\n      \"notes\": \"4K Full Frame\",\n      \"order\": 1\n    },\n    {\n      \"group\": \"AUDIO\",\n      \"title\": \"Yamaha QL5\",\n      \"qty\": 1,\n      \"notes\": \"32-channel mixer\",\n      \"order\": 2\n    }\n  ]\n}",
