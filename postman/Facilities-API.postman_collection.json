                  "raw": "{\n  \"solutionId\": 2,\n  \"type\": \"FLIGHT_CASE\",\n  \"slug\": \"flight-cases\",\n  \"title\": \"Flight Cases\",\n  \"summary\": \"Professional broadcast flight cases equipped with full production infrastructure.\",\n  \"description\": \"Our broadcast flight cases are designed for rapid deployment and high reliability, housing complete production, switching, audio, replay, and monitoring systems in compact mobile units.\",\n  \"coverImage\": \"https://example.com/images/facilities/flight-cases.jpg\",\n  \"gallery\": [\n    {\n      \"url\": \"https://example.com/images/facilities/flight-case-1.jpg\",\n      \"alt\": \"Flight Case Interior\"\n    }\n  ],\n  \"isPublished\": false,\n  \"order\": 1\n}",
